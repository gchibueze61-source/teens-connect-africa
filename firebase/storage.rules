rules_version = '2';
service firebase.storage { match /b/{bucket}/o {
 function signedIn(){ return request.auth != null; }
 function founder(){ return signedIn() && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'founder'; }
 function volunteer(){ return signedIn() && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['volunteer','founder']; }
 match /public/{allPaths=**} { allow read: if true; allow write: if founder(); }
 match /volunteer/{allPaths=**} { allow read: if volunteer(); allow write: if founder(); }
 match /reports/{allPaths=**} { allow read: if volunteer(); allow write: if founder(); }
 match /{allPaths=**} { allow read, write: if founder(); }
}}
