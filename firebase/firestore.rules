rules_version = '2';
service cloud.firestore { match /databases/{database}/documents {
 function signedIn(){ return request.auth != null; }
 function role(){ return signedIn() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role : 'public'; }
 function founder(){ return role() == 'founder'; }
 function volunteer(){ return role() in ['volunteer','founder']; }
 match /programs/{id} { allow read: if resource.data.status == 'published' || founder(); allow write: if founder(); }
 match /events/{id} { allow read: if resource.data.status == 'published' || volunteer(); allow write: if founder(); }
 match /announcements/{id} { allow read: if volunteer(); allow write: if founder(); }
 match /reports/{id} { allow read: if volunteer() && (resource.data.sharedWithVolunteers == true || founder()); allow write: if founder(); }
 match /gallery/{id} { allow read: if resource.data.public == true || volunteer(); allow write: if founder(); }
 match /users/{uid} { allow read, update: if signedIn() && (request.auth.uid == uid || founder()); allow create: if signedIn(); allow delete: if founder(); }
 match /volunteerApplications/{id} { allow create: if true; allow read, update, delete: if founder(); }
 match /newsletter/{id} { allow create: if true; allow read, update, delete: if founder(); }
 match /contactMessages/{id} { allow create: if true; allow read, update, delete: if founder(); }
 match /{document=**} { allow read, write: if founder(); }
}}
